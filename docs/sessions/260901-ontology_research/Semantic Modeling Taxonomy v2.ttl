<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Upper_Ontology>
    a owl:Class;
    rdfs:comment
        "ontology that defines very general, domain-independent concepts like object, event, time, and space to provide a foundation for integration.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Upper Ontology";
