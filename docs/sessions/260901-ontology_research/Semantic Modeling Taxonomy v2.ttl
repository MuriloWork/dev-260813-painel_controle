<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoning_Concept>
    a owl:Class;
    rdfs:comment
        "semantic modeling process of deriving new facts or conclusions from existing knowledge using logical rules and inference.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Reasoning Concept";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Modeling>;
