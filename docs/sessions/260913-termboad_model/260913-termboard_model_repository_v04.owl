        <skos:prefLabel>folder</skos:prefLabel>
        <skos:altLabel>directory</skos:altLabel>
        <skos:altLabel>path</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#File">
        <rdfs:comment>A single file within a repository.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>file</rdfs:label>
