<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Taxonomy>
    a owl:Class;
    rdfs:comment
        "knowledge organization system that provides a hierarchical classification system organizing concepts into parent-child relationships.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Taxonomy";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Organization_System>;
