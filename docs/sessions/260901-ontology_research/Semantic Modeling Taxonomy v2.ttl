    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Property_Characteristic>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Reification>
    a owl:Class, skos:Concept;
    rdfs:comment
        "graph concept technique for making statements about statements by treating a triple as a resource.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
