<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Prefix>
    a owl:Class;
    rdfs:comment
        "naming concept that maps to a full namespace IRI to make IRIs more readable.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Prefix";
