    <owl:Ontology rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890">
        <dc:title>260913-termboard_model_repository_v04_corrected</dc:title>
        <dct:modified>16-9-2026</dct:modified>
        <rdfs:comment>Repository concept model v04 (corrected) - Faceted classification using ONLY standard SKOS/RDFS/OWL predicates. No custom properties.</rdfs:comment>
        <rdfs:label>260913-termboard_model_repository_v04_corrected</rdfs:label>
        <owl:versionInfo>4.1</owl:versionInfo>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!--                    CONCEPT SCHEMES (FACETS)                  -->
    <!-- ============================================================ -->

    <!-- Facet: Content - What the repository stores -->
    <skos:ConceptScheme rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ContentScheme">
        <skos:prefLabel>Content Type Scheme</skos:prefLabel>
        <skos:definition>Facet defining what a repository stores or contains.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
    </skos:ConceptScheme>

    <!-- Facet: Structure - How the repository is organized -->
    <skos:ConceptScheme rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#StructureScheme">
        <skos:prefLabel>Structure Scheme</skos:prefLabel>
        <skos:definition>Facet defining how a repository is organized internally.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
    </skos:ConceptScheme>

    <!-- Facet: Process - What operations happen in the repository -->
    <skos:ConceptScheme rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ProcessScheme">
        <skos:prefLabel>Process Scheme</skos:prefLabel>
        <skos:definition>Facet defining what operations or events occur in a repository.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
    </skos:ConceptScheme>

    <!-- Facet: Tool - What tool manages the repository -->
    <skos:ConceptScheme rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ToolScheme">
        <skos:prefLabel>Tool Scheme</skos:prefLabel>
        <skos:definition>Facet defining what software manages the repository.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
    </skos:ConceptScheme>

    <!-- Facet: Scope - Access and visibility -->
    <skos:ConceptScheme rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme">
        <skos:prefLabel>Scope Scheme</skos:prefLabel>
        <skos:definition>Facet defining access, visibility, and location of a repository.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
    </skos:ConceptScheme>

    <!-- ============================================================ -->
    <!--              CORE CONCEPT: REPOSITORY (All Facets)          -->
    <!-- ============================================================ -->

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository">
        <rdfs:comment>A centralized, version-controlled storage system. Hub concept that belongs to ALL facets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>repository</rdfs:label>
        <skos:definition>A centralized, version-controlled storage system.</skos:definition>
        <skos:prefLabel>repository</skos:prefLabel>
        <skos:altLabel>repo</skos:altLabel>
        <skos:altLabel>codebase</skos:altLabel>
        <skos:altLabel>source control</skos:altLabel>
        <!-- topConceptOf: Repository is the top concept in each facet -->
        <skos:topConceptOf rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ContentScheme"/>
        <skos:topConceptOf rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#StructureScheme"/>
        <skos:topConceptOf rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ProcessScheme"/>
        <skos:topConceptOf rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ToolScheme"/>
        <skos:topConceptOf rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme"/>
        <!-- narrower: Children in each facet -->
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#CodeContent"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#DocumentContent"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#DataContent"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ArtifactContent"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ConfigContent"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Folder"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#File"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Branch"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Tag"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Commit"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Merge"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Release"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Clone"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#PullRequest"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Git"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#SVN"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Mercurial"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Local"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Remote"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Private"/>
        <skos:narrower rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Public"/>
    </skos:Concept>

