{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Leve)",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve"
      ],
      "enabled": false
    },
    "supabase": {
      "type": "local",
      "command":  [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.supabase.com/mcp"
      ],
      "enabled": false
    }
  },
  "plugin": [
    "@ramtinj95/opencode-tokenscope@latest"
  ]
}
