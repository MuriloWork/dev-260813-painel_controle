<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Triplestore>
    a owl:Class;
    rdfs:comment
    "graph storage designed for storing and querying RDF triples efficiently.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Triplestore";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Graph_Storage>;
