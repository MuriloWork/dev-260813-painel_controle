<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Unnamed_Individual>
    a owl:Class;
    rdfs:comment
    "individual represented by a blank node without a global URI identifier.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Unnamed Individual";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Individual>;
