<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Property_Graph>
    a owl:Class;
    rdfs:comment
        "graph concept where both nodes and edges can have properties, often used in graph databases.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
