{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "read": "allow",
    "webfetch": "allow",
    "question": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "skill": "allow"
  },
  "agent": {
    "session-planner": {
      "disable": true,
      "description": "planeja sessão, valida plenajemento de sessão, atualiza planejamento de sessão, tudo conforme template",
      "mode": "subagent",
      "prompt": "{file:./.opencode/agents/session-planner.md}",
      "tools": {}
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Leve)",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command":  [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.supabase.com/mcp"
      ],
      "enabled": false
    }
  },
"plugin": [
  "@ramtinj95/opencode-tokenscope@latest"
]
}
