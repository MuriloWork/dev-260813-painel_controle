<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#SubClassOf>
    a owl:Class;
    rdfs:comment
        "model element relationship indicating that one class is a specialization or subset of another.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "SubClassOf";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Model_Element>;
