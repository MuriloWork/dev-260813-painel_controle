<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#RDFXML>
    a owl:Class;
    rdfs:comment "serialization format that uses XML to encode RDF data.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "RDF/XML";
