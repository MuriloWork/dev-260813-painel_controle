<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Range>
    a owl:Class;
    rdfs:comment
        "model element specifying the class, datatype, or set of values that a property can have.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
