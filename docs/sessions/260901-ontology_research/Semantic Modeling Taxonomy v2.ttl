    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Standard>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Paradigm>
    a owl:Class;
    rdfs:comment
        "semantic modeling component encompassing the collection of methodologies, frameworks, and communities that apply semantic technologies.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
