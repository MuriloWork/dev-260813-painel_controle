{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codesearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Leve)",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote",
          "https://mcp.supabase.com/mcp"
        ],
        "disabled": false
      },
      "code-review-graph": {
        "type": "local",
        "command": [
          "/home/linux_mu/venvs/pessoal/bin/python3",
          "-m",
          "code_review_graph",
          "serve",
          "--repo",
          "/mnt/c/Users/muril/OneDrive/01 mycloud/01-sistMu/11-systems/01-root/dev/260813-painel_controle"
        ],
        "disabled": false
      }
    }
  },
  "plugins": []
}