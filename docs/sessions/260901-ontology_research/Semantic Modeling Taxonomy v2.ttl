<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Web>
    a owl:Class;
    rdfs:comment
    "paradigm of a web of data that machines can understand and process.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Semantic Web";
