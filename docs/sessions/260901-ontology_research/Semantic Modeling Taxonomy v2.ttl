<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#TriG>
    a owl:Class;
    rdfs:comment
        "serialization format that extends Turtle to support named graphs by grouping triples into graph blocks.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "TriG";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Serialization_Format>;
