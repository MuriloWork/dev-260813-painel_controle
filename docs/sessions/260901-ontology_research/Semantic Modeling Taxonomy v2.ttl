<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#RDF_Graph>
    a owl:Class;
    rdfs:comment
        "graph structure consisting of a set of RDF triples that together describe resources and their relationships.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
