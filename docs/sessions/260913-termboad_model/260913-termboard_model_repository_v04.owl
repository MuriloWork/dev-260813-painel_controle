        <skos:definition>A single snapshot of repository state at a point in time.</skos:definition>
        <skos:prefLabel>commit</skos:prefLabel>
        <skos:altLabel>revision</skos:altLabel>
        <skos:altLabel>changeset</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Merge">
        <rdfs:comment>The process of combining changes from one branch into another.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>merge</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ProcessScheme"/>
