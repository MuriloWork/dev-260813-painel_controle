<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Predicate>
    a owl:Class;
    rdfs:comment
        "triple element that specifies the property or relationship being asserted between a subject and an object.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Predicate";
