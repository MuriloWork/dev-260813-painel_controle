    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Organization_System>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Transitive_Property>
    a owl:Class;
    rdfs:comment
        "property characteristic where if A relates to B and B relates to C, then A relates to C.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Transitive Property";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Property_Characteristic>;
    skos:prefLabel "Transitive Property";
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_a>
