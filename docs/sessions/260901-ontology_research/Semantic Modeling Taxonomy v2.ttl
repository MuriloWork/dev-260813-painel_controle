<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Quad>
    a owl:Class;
    rdfs:comment
        "graph concept that extends a triple with a fourth element specifying the named graph it belongs to.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
