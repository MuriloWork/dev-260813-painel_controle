<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#SHACL>
    a owl:Class;
    rdfs:comment
        "standard language for validating RDF graphs against a set of conditions defined as shapes.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "SHACL";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Standard>;
