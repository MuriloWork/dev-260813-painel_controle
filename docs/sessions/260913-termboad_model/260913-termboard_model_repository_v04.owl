        <skos:prefLabel>release</skos:prefLabel>
        <skos:altLabel>version</skos:altLabel>
        <skos:altLabel>build</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Clone">
        <rdfs:comment>The action of creating a local copy of a remote repository.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>clone</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ProcessScheme"/>
