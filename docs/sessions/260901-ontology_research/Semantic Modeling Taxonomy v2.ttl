<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Serialization_Format>
    a owl:Class;
    rdfs:comment
        "semantic modeling component representing a concrete syntax format for encoding and storing semantic data.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Serialization Format";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Modeling>;
