<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoner>
    a owl:Class;
    rdfs:comment
        "reasoning concept component that performs logical inference over semantic data using rules and axioms.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Reasoner";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoning_Concept>;
