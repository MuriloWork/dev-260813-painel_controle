<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Value>
    a owl:Class;
    rdfs:comment
        "semantic modeling component representing the concrete data content assigned to properties, including literals and language-tagged strings.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
