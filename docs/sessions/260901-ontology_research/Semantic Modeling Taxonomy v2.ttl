<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Triple>
    a owl:Class;
    rdfs:comment
    "graph concept consisting of a subject, predicate, and object.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
