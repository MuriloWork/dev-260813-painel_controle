<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Modeling>
    a owl:Class;
    rdfs:comment
        "model development practice of creating explicit, machine-readable representations of knowledge that capture meaning and relationships.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Semantic Modeling";
    skos:prefLabel "Semantic Modeling".
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Property>
    a owl:Class;
    rdfs:comment
        "property that defines a relationship or attribute with specific logical meaning in an ontology.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Semantic Property";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Property>;
