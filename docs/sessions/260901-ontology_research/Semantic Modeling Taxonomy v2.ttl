<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#URI>
    a owl:Class;
    rdfs:comment
        "semantic resource identifier that provides a globally unique string for identifying a resource.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "URI";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Resource_Identifier>;
