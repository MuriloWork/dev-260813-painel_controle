<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Query_Language>
    a owl:Class;
    rdfs:comment
        "standard that defines a formal syntax and protocol for retrieving and manipulating structured data.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
