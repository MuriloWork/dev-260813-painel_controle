        <skos:prefLabel>pull request</skos:prefLabel>
        <skos:altLabel>merge request</skos:altLabel>
        <skos:altLabel>code review</skos:altLabel>
    </skos:Concept>

    <!-- ============================================================ -->
    <!--              FACET: TOOL (What manages it)                  -->
    <!-- ============================================================ -->

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Git">
        <rdfs:comment>Distributed version control system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>Git</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ToolScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Distributed version control system.</skos:definition>
        <skos:prefLabel>Git</skos:prefLabel>
        <skos:altLabel>git</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#SVN">
        <rdfs:comment>Centralized version control system (Apache Subversion).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>SVN</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ToolScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Centralized version control system (Apache Subversion).</skos:definition>
        <skos:prefLabel>SVN</skos:prefLabel>
        <skos:altLabel>Subversion</skos:altLabel>
        <skos:altLabel>Apache Subversion</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Mercurial">
        <rdfs:comment>Distributed version control system (legacy).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>Mercurial</rdfs:label>
