    <!--             FACET: STRUCTURE (How it's organized)           -->
    <!-- ============================================================ -->

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Folder">
        <rdfs:comment>A directory organizing files within a repository.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>folder</rdfs:label>
