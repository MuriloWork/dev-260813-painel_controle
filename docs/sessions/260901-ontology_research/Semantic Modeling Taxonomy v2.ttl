<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Standard>
    a owl:Class;
    rdfs:comment
        "semantic modeling component providing formal specification and recommendation that defines how semantic technologies should be implemented and used, developed by bodies like the W3C to ensure interoperability.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Standard";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Semantic_Modeling>;
