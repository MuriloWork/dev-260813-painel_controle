<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Ontology>
    a owl:Class;
    rdfs:comment
        "knowledge representation that provides a formal, explicit specification of a shared conceptualization within a domain.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Ontology";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Representation>;
    skos:prefLabel "Ontology";
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_a>
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Representation>;
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_subclass_of>
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Representation>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Ontology_Module>
    a owl:Class;
    rdfs:comment
        "ontology component that is self-contained and reusable, supporting modular design and distributed development.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Ontology Module";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Ontology>;
    skos:prefLabel "Ontology Module";
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_a>
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Ontology>;
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_subclass_of>
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Ontology>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Open_World_Assumption>
    a owl:Class;
    rdfs:comment
        "reasoning concept where the absence of a statement does not mean it is false, only that it is unknown.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Open World Assumption";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoning_Concept>;
    skos:prefLabel "Open World Assumption";
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_a>
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoning_Concept>;
