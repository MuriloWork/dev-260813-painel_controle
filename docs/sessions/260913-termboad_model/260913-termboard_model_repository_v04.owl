        <skos:prefLabel>Mercurial</skos:prefLabel>
        <skos:altLabel>Hg</skos:altLabel>
    </skos:Concept>

    <!-- ============================================================ -->
    <!--              FACET: SCOPE (Access/Visibility)               -->
    <!-- ============================================================ -->

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Local">
        <rdfs:comment>Repository exists only on local machine.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>local</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Repository exists only on local machine.</skos:definition>
        <skos:prefLabel>local</skos:prefLabel>
        <skos:altLabel>local only</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Remote">
        <rdfs:comment>Repository is hosted on a server.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>remote</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Repository is hosted on a server.</skos:definition>
        <skos:prefLabel>remote</skos:prefLabel>
        <skos:altLabel>hosted</skos:altLabel>
        <skos:altLabel>server</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Private">
        <rdfs:comment>Repository access is restricted to authorized users.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>private</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Repository access is restricted to authorized users.</skos:definition>
        <skos:prefLabel>private</skos:prefLabel>
        <skos:altLabel>restricted</skos:altLabel>
        <skos:altLabel>internal access</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Public">
        <rdfs:comment>Repository is accessible to everyone.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>public</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#ScopeScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>Repository is accessible to everyone.</skos:definition>
        <skos:prefLabel>public</skos:prefLabel>
        <skos:altLabel>open</skos:altLabel>
        <skos:altLabel>open source</skos:altLabel>
    </skos:Concept>

</rdf:RDF>
