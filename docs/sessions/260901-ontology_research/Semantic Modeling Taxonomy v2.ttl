<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#RDF>
    a owl:Class;
    rdfs:comment
        "standard for representing data as graphs of subject-predicate-object triples, providing a flexible model for describing resources and their relationships.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
