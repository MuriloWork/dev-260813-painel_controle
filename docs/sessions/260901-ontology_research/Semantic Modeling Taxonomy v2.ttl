<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Subject_Heading>
    a owl:Class;
    rdfs:comment
        "knowledge organization system term or phrase used to describe the subject matter of resources in a catalog or database.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Subject Heading";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Organization_System>;
    skos:prefLabel "Subject Heading";
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#is_a>
