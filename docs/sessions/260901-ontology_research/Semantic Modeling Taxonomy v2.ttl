<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#RDFS>
    a owl:Class;
    rdfs:comment
        "standard vocabulary extension to RDF that adds basic modeling primitives like classes and properties.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
