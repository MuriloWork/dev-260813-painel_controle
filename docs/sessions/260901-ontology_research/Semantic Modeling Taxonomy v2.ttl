<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Thesaurus>
    a owl:Class;
    rdfs:comment
        "knowledge organization system organized by semantic relationships including synonyms, broader, and narrower terms.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Thesaurus";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Organization_System>;
