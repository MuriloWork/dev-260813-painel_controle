<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Subject>
    a owl:Class;
    rdfs:comment
        "triple component that identifies the resource being described, typically a URI or blank node.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Subject";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Triple>;
