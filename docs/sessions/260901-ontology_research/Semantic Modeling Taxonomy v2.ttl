    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Reasoning_Concept>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#OWL>
    a owl:Class;
    rdfs:comment
        "standard semantic markup language for creating complex ontologies with logical axioms and constraints.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "OWL";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Standard>;
