<545fd378-f141-21a6-42e3-ba868aff0f06#Closed_World_Assumption>
    a owl:Class, skos:Concept;
    rdfs:comment
        "reasoning concept where any statement not known to be true is assumed to be false.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Closed World Assumption";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>;
    skos:definition
        "reasoning concept where any statement not known to be true is assumed to be false.";
    skos:prefLabel "Closed World Assumption";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>.
<545fd378-f141-21a6-42e3-ba868aff0f06#closeMatch>
    a owl:Class, skos:Concept;
    rdfs:comment
        "linking property indicating that two concepts are sufficiently similar to be used interchangeably in some applications.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "closeMatch";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:definition
        "linking property indicating that two concepts are sufficiently similar to be used interchangeably in some applications.";
    skos:prefLabel "closeMatch";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Concept_Scheme>
    a owl:Class, skos:Concept;
    rdfs:comment
        "knowledge organization system that organizes concepts by semantic relationships, typically defined in SKOS to represent a set of interrelated ideas.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Concept Scheme";
    rdfs:subClassOf
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Organization_System>;
    skos:broader
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Organization_System>;
