<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#T-Box>
    a owl:Class;
    rdfs:comment
        "knowledge representation component of a knowledge base that defines the vocabulary, classes, and properties.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "T-Box";
    rdfs:subClassOf
    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Knowledge_Representation>;
