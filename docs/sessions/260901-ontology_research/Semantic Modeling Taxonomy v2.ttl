    a owl:Class;
    rdfs:comment
        "linking property indicating that two concepts are associated in meaning within the same concept scheme.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "related";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Linking_Property>;
