        <skos:prefLabel>file</skos:prefLabel>
        <skos:altLabel>source file</skos:altLabel>
        <skos:altLabel>artifact file</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Branch">
        <rdfs:comment>A parallel line of development within a repository.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>branch</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#StructureScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
        <skos:definition>A parallel line of development within a repository.</skos:definition>
        <skos:prefLabel>branch</skos:prefLabel>
        <skos:altLabel>feature branch</skos:altLabel>
        <skos:altLabel>dev branch</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Tag">
        <rdfs:comment>A named pointer to a specific commit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>tag</rdfs:label>
        <skos:inScheme rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#StructureScheme"/>
        <skos:broader rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#repository"/>
