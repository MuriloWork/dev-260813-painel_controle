<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#RDF-star>
    a owl:Class;
    rdfs:comment
        "graph representation that provides an efficient way to make statements about statements.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
