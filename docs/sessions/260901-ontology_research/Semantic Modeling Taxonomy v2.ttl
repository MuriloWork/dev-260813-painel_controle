ont:545fd378-f141-21a6-42e3-ba868aff0f06
    a owl:Ontology;
    dc:title "Imported Document";
    dct:modified "9-9-2026";
    rdfs:comment
    "Ontology exported from Termboard - a visual knowledge modeling tool.";
    rdfs:label "Imported Document";
    owl:versionInfo "1.0".
<545fd378-f141-21a6-42e3-ba868aff0f06#A-Box>
    a owl:Class, skos:Concept;
    rdfs:comment
        "knowledge representation that contains the actual instance data and facts of a knowledge base, representing concrete individuals and their property values.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "A-Box";
    rdfs:subClassOf
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>;
    skos:broader
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>;
    skos:definition
        "knowledge representation that contains the actual instance data and facts of a knowledge base, representing concrete individuals and their property values.";
    skos:prefLabel "A-Box";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Annotation_Property>
    a owl:Class, skos:Concept;
    rdfs:comment
        "semantic property used to add metadata or documentation to model elements without affecting logical reasoning.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Annotation Property";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Semantic_Property>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Semantic_Property>;
    skos:definition
        "semantic property used to add metadata or documentation to model elements without affecting logical reasoning.";
    skos:prefLabel "Annotation Property";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Semantic_Property>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Application_Ontology>
    a owl:Class, skos:Concept;
    rdfs:comment
        "ontology tailored to the specific needs and processes of a particular application or use case.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Application Ontology";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Ontology>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Ontology>;
    skos:definition
        "ontology tailored to the specific needs and processes of a particular application or use case.";
    skos:prefLabel "Application Ontology";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Ontology>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Application_Profile>
    a owl:Class, skos:Concept;
    rdfs:comment
        "knowledge representation that combines and constrains elements from multiple vocabularies to meet specific needs.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Application Profile";
    rdfs:subClassOf
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>;
    skos:broader
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>;
    skos:definition
        "knowledge representation that combines and constrains elements from multiple vocabularies to meet specific needs.";
    skos:prefLabel "Application Profile";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Knowledge_Representation>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Asymmetric_Property>
    a owl:Class, skos:Concept;
    rdfs:comment
        "property characteristic where if A relates to B, then B cannot relate to A";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Asymmetric Property";
    rdfs:subClassOf
    <545fd378-f141-21a6-42e3-ba868aff0f06#Property_Characteristic>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Property_Characteristic>;
    skos:definition
        "property characteristic where if A relates to B, then B cannot relate to A";
    skos:prefLabel "Asymmetric Property";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Property_Characteristic>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Authority_File>
    a owl:Class, skos:Concept;
    rdfs:comment
        "knowledge organization system that provides a curated list of authorized forms of names or terms to ensure consistency.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Authority File";
