<545fd378-f141-21a6-42e3-ba868aff0f06#RDFXML>
    a owl:Class, skos:Concept;
    rdfs:comment "serialization format that uses XML to encode RDF data.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
