<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#SPARQL_Endpoint>
    a owl:Class;
    rdfs:comment
    "data service that accepts SPARQL queries over HTTP and returns results.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "SPARQL Endpoint";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Data_Service>;
