    <545fd378-f141-21a6-42e3-ba868aff0f06#Model_Element>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Class>
    a owl:Class, skos:Concept;
    rdfs:comment
        "model element representing a category or type that groups individuals sharing common characteristics.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
