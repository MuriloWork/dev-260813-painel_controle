        <skos:definition>The process of combining changes from one branch into another.</skos:definition>
        <skos:prefLabel>merge</skos:prefLabel>
        <skos:altLabel>integration</skos:altLabel>
        <skos:altLabel>branch merge</skos:altLabel>
    </skos:Concept>

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Release">
        <rdfs:comment>A packaged version of software at a specific point in time.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890"/>
        <rdfs:label>release</rdfs:label>
