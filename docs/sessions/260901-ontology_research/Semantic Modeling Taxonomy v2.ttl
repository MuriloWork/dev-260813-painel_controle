    <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Validation_Mechanism>.
<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#SKOS>
    a owl:Class;
    rdfs:comment
        "standard for representing taxonomies, thesauri, and classification schemes in RDF.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "SKOS";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Standard>;
