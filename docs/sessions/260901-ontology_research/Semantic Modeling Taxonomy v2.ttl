<545fd378-f141-21a6-42e3-ba868aff0f06#Reasoner>
    a owl:Class, skos:Concept;
    rdfs:comment
        "reasoning concept component that performs logical inference over semantic data using rules and axioms.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Reasoner";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>;
    skos:definition
        "reasoning concept component that performs logical inference over semantic data using rules and axioms.";
    skos:prefLabel "Reasoner";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Reasoning_Concept>
    a owl:Class, skos:Concept;
    rdfs:comment
        "semantic modeling process of deriving new facts or conclusions from existing knowledge using logical rules and inference.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Reasoning Concept";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Semantic_Modeling>;
