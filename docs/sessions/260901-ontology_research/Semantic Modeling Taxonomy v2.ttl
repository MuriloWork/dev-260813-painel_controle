<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#SPARQL>
    a owl:Class;
    rdfs:comment
        "query language and protocol that retrieves and manipulates RDF graph data, supporting pattern matching, filtering, aggregation, and federated queries across endpoints.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "SPARQL";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Query_Language>;
