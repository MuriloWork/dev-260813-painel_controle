<545fd378-f141-21a6-42e3-ba868aff0f06#broader>
    a owl:Class, skos:Concept;
    rdfs:comment
        "linking property indicating that one concept is more general than another within the same concept scheme.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "broader";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:definition
        "linking property indicating that one concept is more general than another within the same concept scheme.";
    skos:prefLabel "broader";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>.
<545fd378-f141-21a6-42e3-ba868aff0f06#broadMatch>
    a owl:Class, skos:Concept;
    rdfs:comment
        "linking property indicating that one concept is broader in meaning than another across different concept schemes.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "broadMatch";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:broader <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>;
    skos:definition
        "linking property indicating that one concept is broader in meaning than another across different concept schemes.";
    skos:prefLabel "broadMatch";
    <545fd378-f141-21a6-42e3-ba868aff0f06#is_subclass_of>
    <545fd378-f141-21a6-42e3-ba868aff0f06#Linking_Property>.
<545fd378-f141-21a6-42e3-ba868aff0f06#Cardinality>
    a owl:Class, skos:Concept;
    rdfs:comment
        "model element representing a constraint on the number of values a property can have for an individual.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "Cardinality";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Model_Element>;
