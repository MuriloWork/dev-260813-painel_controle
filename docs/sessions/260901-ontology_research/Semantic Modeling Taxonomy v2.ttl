<545fd378-f141-21a6-42e3-ba868aff0f06#RDFS>
    a owl:Class, skos:Concept;
    rdfs:comment
        "standard vocabulary extension to RDF that adds basic modeling primitives like classes and properties.";
    rdfs:isDefinedBy ont:545fd378-f141-21a6-42e3-ba868aff0f06;
    rdfs:label "RDFS";
    rdfs:subClassOf <545fd378-f141-21a6-42e3-ba868aff0f06#Standard>;
