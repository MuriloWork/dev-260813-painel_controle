        <skos:prefLabel>tag</skos:prefLabel>
        <skos:altLabel>version tag</skos:altLabel>
        <skos:altLabel>release tag</skos:altLabel>
    </skos:Concept>

    <!-- ============================================================ -->
    <!--              FACET: PROCESS (What happens)                  -->
    <!-- ============================================================ -->

    <skos:Concept rdf:about="https://termboard.com/ontology/f1a2b3c4-d5e6-7890-abcd-ef1234567890#Commit">
        <rdfs:comment>A single snapshot of repository state at a point in time.</rdfs:comment>
