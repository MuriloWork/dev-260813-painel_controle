<19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Shape>
    a owl:Class;
    rdfs:comment
        "validation mechanism that defines a set of constraints for what valid data should look like for a particular use case.";
    rdfs:isDefinedBy ont:19125a96-5dd9-3b4f-78a7-0baac7c5e82f;
    rdfs:label "Shape";
    rdfs:subClassOf <19125a96-5dd9-3b4f-78a7-0baac7c5e82f#Validation_Mechanism>;
